<?xml version="1.0" encoding="utf-8"?>
<!--
    The transport gate is open: the platform permits cleartext HTTP to any host, so a
    plain-HTTP LAN server — the default `lan` provider's deployment — is reachable from
    this app the same way it is from the desktop client.

    There is deliberately no domain list here. The policy lives in
    `validateServerAddress` (packages/feature-settings-domain), which gates every entry
    point — the Settings field and the `tasktracker://connect` prefill — on every
    platform: `https` anywhere, `http` only for loopback, RFC1918, link-local,
    CGNAT/Tailscale, `.local`, and single-label names. A public host over `http` is
    refused there at save time, so this file carries no rule of its own to keep in sync.

    Loopback and the emulator's `10.0.2.2` need no entry: they were always inside the
    policy, and this config no longer excludes anything it permits.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
