<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is denied by default, which is the right posture for a self-hosted app: a
    real deployment should reach its server over HTTPS, and the value it is given through
    `tasktracker.apiBaseUrl` will be an `https://` URL.

    The exceptions are the local development server, which speaks plain HTTP on port 8080.
    `10.0.2.2` is the address an Android emulator uses to reach the machine running it, and
    `localhost` covers a `adb reverse tcp:8080 tcp:8080` port-forward. Without these entries the
    default API root would be blocked by the platform and the first request would fail with a
    `CleartextNotPermittedException` that names neither the setting nor this file.

    A deployment whose server is genuinely plain HTTP must add its host here; that is a
    deliberate decision rather than a silent default.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
