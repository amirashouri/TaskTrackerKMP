<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Local-network access, for the API roots that can legitimately be on the local network:
        the emulator's `10.0.2.2` host alias, and any LAN address a deployment names. Android's
        Local Network Protection gates those connections behind this runtime permission, and it
        fails silently — a blocked connection times out instead of being refused — so without
        the permission the app reports "Could not reach the server" against a server that is
        running and reachable. Measured on an API 37 emulator: every port from the app's uid
        timed out while the same probe from `adb shell` answered.

        Requested from `MainActivity`, and only when the build's API root is itself a
        local-network address (`apiRootRequiresLocalNetworkAccess`), so a deployment pointed at
        a public hostname is never asked. Declared here unconditionally because the permission
        only exists, and is only required, from `targetSdk` 37 — which is where this app sits;
        older platforms ignore an unknown permission.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".TaskTrackerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TaskTracker">

        <!--
            The API root this build talks to, read at runtime by `platformApiBaseUrl` in
            `:composition-root`. The placeholder is filled from the `tasktracker.apiBaseUrl`
            Gradle property and is left empty by default, so the Kotlin fallback
            (`http://10.0.2.2:8080`, the emulator's alias for the machine running the server)
            stays the one place the default lives. A real deployment overrides it at build time:

                ./gradlew :androidApp:assembleDebug -Ptasktracker.apiBaseUrl=https://server.example.com
        -->
        <meta-data
            android:name="com.tasktracker.API_BASE_URL"
            android:value="${tasktrackerApiBaseUrl}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TaskTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The custom scheme every shared deep link uses, including the CLI's
                `tasktracker://connect` pairing link. `BROWSABLE` is what lets a scanner or a
                browser hand the URL over; `DEFAULT` makes the implicit intent resolvable. The
                scheme is the whole selector: the shared parser validates the host and path, so
                a filter per screen would be a second grammar that could disagree with it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tasktracker" />
            </intent-filter>
        </activity>
    </application>
</manifest>
