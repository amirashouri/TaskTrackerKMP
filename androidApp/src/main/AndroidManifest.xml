<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TaskTrackerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TaskTracker">

        <!--
            The API root this build talks to, read at runtime by `platformApiBaseUrl` in
            `:composition-root`. The placeholder is filled from the `tasktracker.apiBaseUrl`
            Gradle property and is left empty by default, so the Kotlin fallback
            (`http://10.0.2.2:8080`, the emulator's alias for the machine running the server)
            stays the one place the default lives. A real deployment overrides it at build time:

                ./gradlew :androidApp:assembleDebug -Ptasktracker.apiBaseUrl=https://server.example.com
        -->
        <meta-data
            android:name="com.tasktracker.API_BASE_URL"
            android:value="${tasktrackerApiBaseUrl}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.TaskTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
