# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.kotlin/

# The KMP build writes its caches into a versioned directory, so the version number
# has to be in the pattern rather than in a second rule that will drift out of date.
.kotlin/sessions/

# Android
local.properties
*.apk
*.aab
*.ap_
*.dex
captures/
.cxx/

# IDE
.idea/
*.iml
*.iws
*.ipr
.fleet/
.kotlin/

# Xcode — iosApp/TaskTracker.xcodeproj is generated by `xcodegen generate` from
# iosApp/project.yml, exactly as TaskTracker.xcodeproj is in the Swift project. The
# manifest is the source of truth; committing the generated project means a hand-edit
# to project.pbxproj can survive long enough to look deliberate, and the next
# `xcodegen generate` silently discards it.
iosApp/*.xcodeproj/
iosApp/*.xcworkspace/
iosApp/xcuserdata/
iosApp/*.xcuserstate
**/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store
