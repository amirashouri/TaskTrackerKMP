<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TaskTracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The API root the app talks to, read at runtime by `platformApiBaseUrl` in
	     :composition-root. It is wired to the TASKTRACKER_API_BASE_URL build setting, which
	     project.yml leaves empty so the Kotlin fallback (http://localhost:8080, which the
	     simulator reaches on the host) is the one place the default lives. A deployment sets
	     the build setting to name its own server. -->
	<key>TaskTrackerApiBaseUrl</key>
	<string>$(TASKTRACKER_API_BASE_URL)</string>

	<!-- A plain-HTTP LAN server — the default `lan` provider's deployment — must be
	     reachable, the way it already is from the desktop client. `NSAllowsLocalNetworking`
	     lifts ATS for local resources (RFC1918, link-local, `.local`) only: cleartext to a
	     public host stays blocked here, matching the client-wide policy in
	     `validateServerAddress`, which refuses a public `http://` root at save time on
	     every platform. The tailscale provider's root is an `https://…ts.net` name and
	     needs no exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Without a purpose string, iOS 14+ denies local-network connections without
	     showing the prompt, and the failure looks like an ordinary transport timeout.
	     The prompt itself is system-driven on the first local connection; there is no
	     request API to call. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>TaskTracker connects to your team's self-hosted TaskTracker server on your local network.</string>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- The system's own launch screen, drawn before the app's first frame and unable to
	     be animated. It is deliberately the plain canvas: the Kotlin splash then draws the
	     same colour plus the mark, so the hand-off between the two is invisible and the
	     branded moment is the one the app controls. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>CanvasBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- `tasktracker://` deep links, parsed by :packages:routing's DeepLinkParser. The
	     grammar is projects, settings, board/<id>, backlog/<id>, archive/<id>,
	     workitem/<pid>/<iid> and workitem/<pid>/new. Android's equivalent is an
	     intent-filter on the launcher activity. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tasktracker</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tasktracker</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
